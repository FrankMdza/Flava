# Never commit credentials. Listed even though nothing here should produce them, because
# an accidental `cp -r ~/.claude .` is exactly how these end up in a public repo.
.credentials.json
.claude.json
*.pem
*.key
*.p12
.env
.env.*
id_rsa
id_ed25519
*.pfx

# Anything with KEY / TOKEN / SECRET in the name, any case. A shell rc that exports an
# API key gets pulled in the moment someone copies ~/.zshrc here; this blocks the file
# before that happens.
*[Kk][Ee][Yy]*
*[Tt][Oo][Kk][Ee][Nn]*
*[Ss][Ee][Cc][Rr][Ee][Tt]*
.zshrc
.bashrc
.bash_profile
.zprofile
.profile
.zshenv
.zlogin

# Local state that Claude Code writes into ~/.claude and that must not travel between
# machines: sessions, transcripts, caches, handoff notes.
sessions/
session-env/
shell-snapshots/
file-history/
handoffs/
projects/
statsig/
todos/
history.jsonl
*.jsonl

# Byproducts
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.swp
*~

# Installer output
.flava-backup-*/
