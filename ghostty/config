# Flava Ghostty config — the macOS terminal, adapted from wezterm/wezterm.lua.
#
# Ghostty replaces WezTerm on this Mac. The look carries over one to one: Catppuccin
# Mocha, JetBrains Mono, 70% opacity with a background blur. The resurrect plugin does
# not: Ghostty has no plugin system and no workspace save/restore. The nearest thing is
# window-save-state, which brings back the window layout after a quit or a crash. The
# ALT+W / ALT+R workspace keybindings from the WezTerm config have no equivalent here
# and are left out rather than bound to something that only half works.

# Theme and typography
theme = Catppuccin Mocha
font-family = JetBrains Mono
font-size = 13

# Transparency and glass effect
background-opacity = 0.7
background-blur = 30

# Native macOS fullscreen moves the window to its own Space with a solid backdrop, which
# kills the blur. Non-native fullscreen just fills the current Space, so the blur holds.
# Trade-off: no separate Space, so no three-finger swipe to it. "visible-menu" keeps the
# menu bar reachable on hover.
macos-non-native-fullscreen = visible-menu

# Clean borders and inner padding. WezTerm used window_decorations = "RESIZE" (no
# titlebar, keep the resize border). Ghostty's nearest equivalent, "hidden", also drops
# the traffic-light buttons and disables the tab bar, so new tabs open as windows.
# "tabs" keeps it minimal, folds the tab bar into the titlebar, and leaves tabs working.
macos-titlebar-style = tabs
window-padding-x = 12
window-padding-y = 12

# Bring the window layout back after quit or crash. Not a full resurrect: no panes or
# scrollback, just the windows and their sizes.
window-save-state = always

# Keybindings. Tabs, splits, and clipboard. macOS-native cmd bindings stay as Ghostty
# ships them; these add the cross-platform ctrl+shift set from the old terminal.
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
